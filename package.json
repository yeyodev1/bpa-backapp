    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.10.5",
    "@vercel/node": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
